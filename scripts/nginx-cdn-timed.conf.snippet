# Optional nginx snippets for better dashboard data.
# install.sh --with-nginx can apply these automatically.

# --- place inside http { } in nginx.conf ---
# log_format cdn_timed '$remote_addr - $remote_user [$time_local] '
#                      '"$request" $status $body_bytes_sent '
#                      '"$http_referer" "$http_user_agent" '
#                      '$request_time xff="$http_x_forwarded_for"';

# --- place inside server { } for the CDN vhost ---
# # If TLS terminates on NPM/proxy in front of this host:
# set_real_ip_from 192.168.1.226;   # NPM IP — edit to your proxy
# set_real_ip_from 192.168.1.0/24;
# real_ip_header X-Forwarded-For;
# real_ip_recursive on;
#
# access_log /var/log/nginx/cdn.flappy.su.access.log cdn_timed;
