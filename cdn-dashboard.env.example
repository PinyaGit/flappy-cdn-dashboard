# Environment for Flappy CDN live dashboard
# Copied to /etc/default/cdn-dashboard by install.sh

# Bind address / port of the dashboard UI
CDN_DASH_HOST=0.0.0.0
CDN_DASH_PORT=8090

# Nginx access log to tail (completed transfers)
CDN_ACCESS_LOG=/var/log/nginx/cdn.flappy.su.access.log

# Nginx listen port used for live TCP stream detection (ss)
CDN_NGINX_PORT=8080

# Comma-separated client IP prefixes allowed to open UI/API (LAN)
# Public internet gets 403.
CDN_DASH_ALLOW=192.168.,10.,127.0.0.1,::1
